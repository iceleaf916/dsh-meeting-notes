{
  "name": "@local/dsh-meeting-notes",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Local meeting recorder and transcriber for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "storage.js",
    "capture.js",
    "asr.js",
    "minutes.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "recorder/main.swift",
    "recorder/build.sh",
    "recorder/README.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
